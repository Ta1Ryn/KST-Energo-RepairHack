<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp"
    tools:context=".presentation.admin.AdminFragment">

    <ImageView
        android:id="@+id/adminLogo"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/company_name"
        android:src="@drawable/logo_kst"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/title_2_semibold.Start"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/admin_title"
        app:layout_constraintBottom_toBottomOf="@id/adminLogo"
        app:layout_constraintEnd_toStartOf="@id/logout"
        app:layout_constraintStart_toEndOf="@id/adminLogo"
        app:layout_constraintTop_toTopOf="@id/adminLogo" />

    <TextView
        android:id="@+id/operationResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminLogo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout"
        style="@style/Widget.RepairHack.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="@string/logout"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/panelGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <TextView
        android:id="@+id/employeesTitle"
        style="@style/title_3_semibold.Start"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/admin_employees"
        app:layout_constraintEnd_toStartOf="@id/addEmployee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/operationResult" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addEmployee"
        style="@style/Widget.RepairHack.Button.Outlined"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/admin_add_employee"
        android:gravity="center"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+"
        android:textAllCaps="false"
        android:textSize="24sp"
        android:tooltipText="@string/admin_add_employee"
        app:layout_constraintEnd_toStartOf="@id/panelGuide"
        app:layout_constraintTop_toBottomOf="@id/operationResult" />

    <EditText
        android:id="@+id/employeeSearch"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_input"
        android:hint="Поиск по ФИО, должности или оборудованию"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColorHint="@color/placeholder"
        app:layout_constraintEnd_toStartOf="@id/panelGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/employeesTitle" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/panelGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/employeeSearch">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/emptyEmployees"
                style="@style/text_regular.Start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:text="@string/admin_empty_employees"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/employeeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/panelGuide"
        app:layout_constraintTop_toBottomOf="@id/operationResult">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/card_radius_sm"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/title_3_semibold.Start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Оборудование и доступ" />

                <EditText
                    android:id="@+id/equipmentSearch"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Поиск по названию, модели, номеру"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:textColorHint="@color/placeholder" />

                <LinearLayout
                    android:id="@+id/equipmentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/card_radius_sm"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/title_3_semibold.Start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_pin_title" />

                <EditText
                    android:id="@+id/adminPin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/new_pin_hint"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:paddingHorizontal="14dp"
                    android:textColorHint="@color/placeholder" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveAdminPin"
                    style="@style/Widget.RepairHack.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="10dp"
                    android:text="@string/admin_save_pin"
                    android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportData"
            style="@style/Widget.RepairHack.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:text="@string/admin_export"
            android:textAllCaps="false" />

        <TextView
            style="@style/caption_regular.Start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/admin_export_hint" />
    </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>