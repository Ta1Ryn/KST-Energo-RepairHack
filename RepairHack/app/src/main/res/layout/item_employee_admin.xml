<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/card_radius_sm"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/employeeName"
                style="@style/title_3_semibold.Start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/employeePin"
                style="@style/caption_regular.Start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/description" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/employeeAccess"
            style="@style/Widget.RepairHack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Доступ"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editEmployee"
            style="@style/Widget.RepairHack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/admin_edit"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetPin"
            style="@style/Widget.RepairHack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Сбросить PIN"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteEmployee"
            style="@style/Widget.RepairHack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/admin_delete"
            android:textAllCaps="false"
            android:textColor="@color/error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
