<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy" android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView" android:layout_width="0dp" android:layout_height="0dp"
        app:implementationMode="compatible" app:scaleType="fitCenter"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <View android:layout_width="0dp" android:layout_height="0dp"
        android:background="@drawable/bg_vignette" android:clickable="false"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back" style="@style/Widget.RepairHack.Button.Camera"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_marginStart="24dp" android:layout_marginTop="24dp" android:text="@string/camera_back"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/cameraTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp" android:gravity="center"
        android:text="Шильдик · прямой эфир" android:textColor="@color/white"
        android:textSize="20sp" android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toTopOf="@id/back" app:layout_constraintBottom_toBottomOf="@id/back"
        app:layout_constraintStart_toEndOf="@id/back" app:layout_constraintEnd_toStartOf="@id/liveInspection" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/liveInspection" style="@style/Widget.RepairHack.Button.Camera"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_marginTop="24dp" android:layout_marginEnd="24dp" android:text="Дефекты онлайн"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <ImageView android:id="@+id/scanFrame" android:layout_width="0dp" android:layout_height="0dp"
        android:contentDescription="Рамка для чтения модели и заводского номера" android:src="@drawable/ic_scan_frame"
        app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_percent="0.32"
        app:layout_constraintHeight_max="280dp"
        app:layout_constraintTop_toBottomOf="@id/back" app:layout_constraintBottom_toTopOf="@id/hintCard"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/hintCard" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="16dp" android:layout_marginBottom="24dp"
        android:background="@drawable/bg_permission_card" android:orientation="vertical" android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/alternativeActions"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/scanStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:text="@string/camera_status"
            android:textColor="@color/white" android:textSize="17sp" />
        <TextView android:id="@+id/scanHint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:maxLines="3" android:ellipsize="end"
            android:text="Текст читается автоматически. Перед открытием паспорта сверим модель и номер."
            android:textColor="#D0D7E6" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/alternativeActions" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginEnd="24dp" android:layout_marginBottom="24dp" android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/platePhoto" style="@style/Widget.RepairHack.Button.Camera"
            android:layout_width="match_parent" android:layout_height="48dp" android:text="Фото шильдика" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualPlate" style="@style/Widget.RepairHack.Button.Camera"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:text="Ввести модель / номер" />
    </LinearLayout>
    <LinearLayout android:id="@+id/permissionCard" android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="@drawable/bg_permission_card" android:orientation="vertical"
        android:padding="20dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="620dp" app:layout_constraintWidth_percent="0.75">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/camera_permission" android:textColor="@color/white" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantCamera" style="@style/Widget.RepairHack.Button"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="16dp" android:text="@string/camera_grant" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
