<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RepairHack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_deep</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomNavigationStyle">@style/Widget.RepairHack.BottomNav</item>
    </style>

    <style name="Theme.RepairHack" parent="Base.Theme.RepairHack" />

    <style name="Widget.RepairHack.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@color/accent_inactive</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="background">@drawable/bg_nav_solid</item>
    </style>

    <style name="Widget.RepairHack.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAppearance">@style/title_3_semibold</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="rippleColor">@color/accent_deep</item>
    </style>

    <style name="Widget.RepairHack.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/caption_semibold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="rippleColor">@color/accent_inactive</item>
    </style>

    <style name="Widget.RepairHack.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/caption_semibold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="strokeColor">@color/accent_inactive</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/accent_inactive</item>
    </style>

    <!-- Кнопки поверх камеры: читаются на тёмном фоне, выбранная — фирменный синий. -->
    <style name="Widget.RepairHack.Button.Camera" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/white</item>
        <item name="backgroundTint">@color/camera_toggle_bg</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Theme.RepairHack.Immediate" parent="Theme.RepairHack">
        <item name="android:windowAnimationStyle">@style/RepairHackImmediateWindowAnimation</item>
    </style>
    <style name="RepairHackImmediateWindowAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
</resources>
