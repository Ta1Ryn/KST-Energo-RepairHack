<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UsePostgreSql Condition="'$(UsePostgreSql)' == '' and Exists('$(MSBuildProjectDirectory)/postgres.local.json')">true</UsePostgreSql>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../database/migrations/*.sql" Link="Database/migrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" Condition="'$(UsePostgreSql)' == 'true'" />
    <Content Include="../database/schema.sql" Link="Database/schema.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Npgsql" Version="10.0.0" Condition="'$(UsePostgreSql)' == 'true'" />
  </ItemGroup>
</Project>
