{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Backend": {
    "DataDirectory": "App_Data",
    "SeedDemoData": false,
    "SessionHours": 12,
    "WarningRemainingFraction": 0.1,
    "TelemetryMaxAgeMinutes": 60,
    "MaxPhotoBytes": 10485760
  },
  "Ai": {
    "BaseUrl": null,
    "AnalyzePath": "analyze",
    "TimeoutSeconds": 30
  },
  "Database": {
    "Provider": "Json",
    "ImportExistingJson": true
  }
}
